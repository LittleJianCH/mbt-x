package moonbitlang/x/lex

// Values

// Types and methods
pub struct Engine {
  pub graph : Array[Array[(Int, Array[Array[Int]])]]
  pub end_nodes : Array[(Int, Array[((Int, Int), (Int, Int))])?]
  pub start_tags : Array[Int]
  pub code_blocks_n : Int
}
impl Engine {
  run(Self, Lexbuf) -> (Int, Array[Bytes])
}

pub struct Lexbuf {
  pub content : Bytes
  pub ptr : Int
}
impl Lexbuf {
  cur_ptr(Self) -> Int
  from_bytes(Bytes) -> Self
  set_ptr(Self, Int) -> Unit
  step(Self) -> Unit
  subbytes(Self, Int, Int) -> Bytes
}

